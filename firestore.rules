rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn() && profile().data.active == true;
    }

    function role() {
      return profile().data.role;
    }

    function operatorId() {
      return profile().data.operatorId;
    }

    function admin() {
      return activeUser() && role() == 'admin';
    }

    function operator() {
      return activeUser() && role() == 'operator';
    }

    function usher() {
      return activeUser() && role() == 'usher';
    }

    function sameOperator(data) {
      return data.operatorId == operatorId();
    }

    match /users/{uid} {
      allow read: if activeUser() && (uid == request.auth.uid || admin() || (operator() && resource.data.operatorId == operatorId()));
      allow write: if false;
    }

    match /operators/{id} {
      allow read: if admin() || (activeUser() && id == operatorId());
      allow write: if false;
    }

    match /ushers/{id} {
      allow read: if admin() || (activeUser() && sameOperator(resource.data));
      allow write: if false;
    }

    match /draws/{id} {
      allow read: if admin() || (activeUser() && sameOperator(resource.data));
      allow write: if false;
    }

    match /betSlips/{id} {
      allow read: if admin()
        || (operator() && sameOperator(resource.data))
        || (usher() && resource.data.createdBy == request.auth.uid);
      allow write: if false;
    }

    match /bets/{id} {
      allow read: if admin()
        || (operator() && sameOperator(resource.data))
        || (usher() && resource.data.createdBy == request.auth.uid);
      allow write: if false;
    }

    match /drawTallies/{drawId}/numbers/{number} {
      allow read: if admin() || (activeUser() && sameOperator(resource.data));
      allow write: if false;
    }

    match /dailyReports/{id} {
      allow read: if admin() || (activeUser() && sameOperator(resource.data));
      allow write: if false;
    }

    match /operatorBillingWeeks/{id} {
      allow read: if admin() || (operator() && sameOperator(resource.data));
      allow write: if false;
    }

    match /auditLogs/{id} {
      allow read: if admin() || (operator() && sameOperator(resource.data));
      allow write: if false;
    }
  }
}
